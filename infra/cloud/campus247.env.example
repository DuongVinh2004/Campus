# /etc/campus247/campus247.env  (mode 0640, owner root:campus247). NOT part of the repository: copy, then fill in.
# Read by every campus247-*.service. Never commit the filled-in file or paste its values into a chat or a log.

# Provider credential: NOT in this file. The gateway sidecar reads DEEPSEEK_API_KEY from /opt/campus247/.env (mode 0600, owner
# campus247), exactly as on the development machine; the API processes never read it. The owner creates that file on the server.

# Model server: a fresh state directory under the workspace and the retained predecessor it continues from.
CAMPUS247_MODELS_STATE=/opt/campus247/infra/local/campus-run-cloud/models
CAMPUS247_MODELS_PREDECESSOR=/opt/campus247/infra/local/campus-run-20261115-02/models

# Name of the built frontend snapshot to serve (a directory under infra/local/knowledge-platform-20261023/).
CAMPUS247_FRONTEND_NAME=frontend-knowledge-ui-identity-20261114-01

# The production safety net stays on: nothing below weakens authentication, authorization, confirmations or source checks.
ENVIRONMENT=development
