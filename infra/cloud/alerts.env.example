# Alert channels for the watchdog and the application. Copy to /etc/campus247/alerts.env (mode 0640, group campus247) and fill in.
# Secrets are never put here directly: each one is a path to a file that only the campus247 user can read (mode 0600).
# The log channel is always on. A channel with a missing setting is skipped, and a log line names which one.

# Telegram: create a bot with @BotFather, put its token in the file, add the bot to the chat and put the chat id below.
#CAMPUS247_ALERT_TELEGRAM_TOKEN_FILE=/etc/campus247/secrets/telegram-token
#CAMPUS247_ALERT_TELEGRAM_CHAT_ID=-1001234567890

# E-mail (TLS is required: port 465 is implicit TLS, any other port uses STARTTLS).
#CAMPUS247_ALERT_SMTP_HOST=smtp.example.org
#CAMPUS247_ALERT_SMTP_PORT=465
#CAMPUS247_ALERT_SMTP_USER=alerts@example.org
#CAMPUS247_ALERT_SMTP_PASSWORD_FILE=/etc/campus247/secrets/smtp-password
#CAMPUS247_ALERT_SMTP_FROM=alerts@example.org
#CAMPUS247_ALERT_SMTP_TO=owner@example.org,second@example.org

# Extra hosts a channel may talk to (comma separated). api.telegram.org and the SMTP host above are always allowed.
#CAMPUS247_ALERT_ALLOWED_HOSTS=

# Where the watchdog keeps its state (default /var/lib/campus247/watchdog, created by systemd).
#CAMPUS247_WATCHDOG_STATE=/var/lib/campus247/watchdog
