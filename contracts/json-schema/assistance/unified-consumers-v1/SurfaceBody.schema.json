{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "surface": {
      "enum": [
        "chat",
        "student_home",
        "staff_queue",
        "settings",
        "certificate",
        "service"
      ],
      "title": "Surface",
      "type": "string"
    },
    "resource": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "field": {
      "anyOf": [
        {
          "enum": [
            "reason",
            "course_record_id",
            "contact_preference",
            "purpose",
            "recipient",
            "quantity",
            "delivery_method"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    }
  },
  "required": [
    "surface"
  ],
  "title": "SurfaceBody",
  "type": "object"
}
