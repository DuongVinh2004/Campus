{
  "$defs": {
    "CoordinationBinding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "conversation_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "session_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Sha256"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "audiences": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Audiences",
          "type": "array"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "goal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Goal Sha256",
          "type": "string"
        },
        "purpose_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Purpose Sha256",
          "type": "string"
        },
        "authority": {
          "const": "read_prepare_only",
          "default": "read_prepare_only",
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "tenant_id",
        "conversation_id",
        "scope_sha256",
        "roles",
        "audiences",
        "goal_sha256",
        "purpose_sha256"
      ],
      "title": "CoordinationBinding",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "TaskBinding": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/CoordinationBinding"
        },
        "coverage_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Sha256",
          "type": "string"
        },
        "budget_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Budget Sha256",
          "type": "string"
        },
        "output_contract": {
          "const": "task-result.v1",
          "default": "task-result.v1",
          "title": "Output Contract",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "coverage_sha256",
        "budget_sha256"
      ],
      "title": "TaskBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^T[1-8]$",
      "title": "Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "research",
        "verifier",
        "document"
      ],
      "title": "Role",
      "type": "string"
    },
    "goal": {
      "maxLength": 700,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "coverage_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Coverage Ids",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "maxItems": 7,
      "title": "Dependencies",
      "type": "array"
    },
    "tools": {
      "items": {
        "enum": [
          "search_knowledge",
          "search_policy_relations",
          "read_source",
          "inspect_evidence",
          "read_document"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Tools",
      "type": "array"
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "role",
    "goal",
    "coverage_ids",
    "tools"
  ],
  "title": "TaskSpec",
  "type": "object"
}