{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "tenant": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant",
      "type": "string"
    },
    "recipient_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Recipient Id",
      "type": "string"
    },
    "audience": {
      "enum": [
        "student",
        "staff"
      ],
      "title": "Audience",
      "type": "string"
    },
    "resource": {
      "$ref": "#/$defs/ResourceRef"
    },
    "trigger": {
      "enum": [
        "feedback",
        "supplement",
        "status",
        "deadline"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "changed_at": {
      "title": "Changed At",
      "type": "string"
    },
    "classification": {
      "enum": [
        "public_student",
        "internal_staff"
      ],
      "title": "Classification",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "tenant",
    "recipient_id",
    "audience",
    "resource",
    "trigger",
    "source_id",
    "source_sha256",
    "changed_at",
    "classification"
  ],
  "title": "BusinessTrackingEvent",
  "type": "object"
}