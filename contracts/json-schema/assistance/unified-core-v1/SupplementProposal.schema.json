{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "classification": {
          "enum": [
            "synthetic",
            "public_snapshot"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version_id",
        "locator",
        "sha256",
        "classification"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "SupplementItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^SUP-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "criterion_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "purpose",
            "recipient",
            "reason",
            "course_record_id",
            "attachment"
          ],
          "title": "Field",
          "type": "string"
        },
        "public_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Public Reason",
          "type": "string"
        },
        "required_evidence": {
          "$ref": "#/$defs/EvidenceRef"
        }
      },
      "required": [
        "id",
        "criterion_id",
        "field",
        "public_reason",
        "required_evidence"
      ],
      "title": "SupplementItem",
      "type": "object"
    },
    "WorkflowBinding": {
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "enum": [
            "STUDENT_CERTIFICATE",
            "GRADE_APPEAL",
            "GENERAL_SUPPORT"
          ],
          "title": "Workflow",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "effective_from": {
          "title": "Effective From",
          "type": "string"
        },
        "effective_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Until"
        }
      },
      "required": [
        "workflow",
        "version",
        "source",
        "effective_from"
      ],
      "title": "WorkflowBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Client Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ResourceRef"
    },
    "workflow_binding": {
      "$ref": "#/$defs/WorkflowBinding"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SupplementItem"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "state": {
      "const": "draft",
      "default": "draft",
      "title": "State",
      "type": "string"
    },
    "action_authority": {
      "const": "none",
      "default": "none",
      "title": "Action Authority",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "target",
    "workflow_binding",
    "items"
  ],
  "title": "SupplementProposal",
  "type": "object"
}