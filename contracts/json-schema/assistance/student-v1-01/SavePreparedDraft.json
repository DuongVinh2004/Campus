{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "StudentGoal": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "workflow": {
          "anyOf": [
            {
              "enum": [
                "STUDENT_CERTIFICATE",
                "GRADE_APPEAL",
                "GENERAL_SUPPORT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "maxProperties": 7,
          "title": "Statements",
          "type": "object"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Constraints",
          "type": "array"
        },
        "operation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "goal",
        "operation_id"
      ],
      "title": "StudentGoal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/StudentGoal"
    },
    "expected_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Sha256",
      "type": "string"
    },
    "reviewed": {
      "const": true,
      "title": "Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "request",
    "expected_sha256",
    "reviewed"
  ],
  "title": "SavePreparedDraft",
  "type": "object"
}