{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "service_request",
            "certificate_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "expected_version"
      ],
      "title": "ResourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "maxItems": 20,
      "title": "Resources",
      "type": "array"
    },
    "surface": {
      "enum": [
        "queue",
        "detail",
        "checklist",
        "editor",
        "error",
        "handover",
        "admin"
      ],
      "title": "Surface",
      "type": "string"
    },
    "intent": {
      "enum": [
        "read",
        "review",
        "prepare",
        "retry",
        "route",
        "publish"
      ],
      "title": "Intent",
      "type": "string"
    }
  },
  "required": [
    "resources",
    "surface",
    "intent"
  ],
  "title": "StaffIntent",
  "type": "object"
}