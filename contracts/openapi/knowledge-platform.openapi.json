  "components": {
    "schemas": {
      "ApplicabilityInput": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "title": "Effective From"
          },
          "effective_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Until"
          },
          "basis": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Basis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "effective_from",
          "basis"
        ],
        "title": "ApplicabilityInput"
      },
      "ConfirmInput": {
        "properties": {
          "preview_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Preview Id"
          },
          "confirmation_token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 20,
            "title": "Confirmation Token"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preview_id",
          "confirmation_token",
          "confirmed"
        ],
        "title": "ConfirmInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginBody": {
        "properties": {
          "account": {
            "type": "string",
            "title": "Account"
          }
        },
        "type": "object",
        "required": [
          "account"
        ],
        "title": "LoginBody"
      },
      "PreviewInput": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "activate",
              "revoke",
              "rollback"
            ],
            "title": "Operation"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Target Id"
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Generation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "target_id",
          "expected_generation"
        ],
        "title": "PreviewInput"
      },
      "ReviewInput": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED"
            ],
            "title": "Verdict"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "verdict",
          "note"
        ],
        "title": "ReviewInput"
      },
      "SearchPreviewInput": {
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid",
            "title": "Release Id"
          },
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "release_id",
          "query"
        ],
        "title": "SearchPreviewInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "IntakeMetadata": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Title",
            "type": "string"
          },
          "owner_unit": {
            "maxLength": 160,
            "minLength": 2,
            "title": "Owner Unit",
            "type": "string"
          },
          "canonical_uri": {
            "maxLength": 1000,
            "minLength": 3,
            "title": "Canonical Uri",
            "type": "string"
          },
          "campus": {
            "const": "HUCE",
            "default": "HUCE",
            "title": "Campus",
            "type": "string"
          },
          "faculties": {
            "items": {
              "const": "FIT",
              "type": "string"
            },
            "minItems": 1,
            "title": "Faculties",
            "type": "array"
          },
          "programs": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Programs",
            "type": "array"
          },
          "audiences": {
            "items": {
              "enum": [
                "STUDENT",
                "SUPPORT_OFFICER",
                "KNOWLEDGE_ADMIN",
                "SYSTEM_ADMIN"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Audiences",
