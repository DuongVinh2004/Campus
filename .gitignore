# Credentials for the separately provisioned local learning module
/infra/local/learning-materials-20261104-01/identity.json
/infra/local/learning-materials-20261104-01/credentials.json

# Secrets retained by this feature's synthetic tests and recovery copies
/.tooling/learning-*/**/identity.json
/.tooling/learning-*/**/credentials.json
/.tooling/learning-*/**/browser-profile*/
/.tooling/learning-pg-live-20261105-01/init-password.txt

# UI screenshots cache (safe to delete; regenerate with scripts/ui_shots.mjs)
infra/local/ui-shots/

# Per-run pytest base temp directories (created in the repo because tests require basetemp inside it)
/.pytest-tmp*/

# Downloaded third-party binaries (pinned and checked in docs/); never commit them
/infra/local/tools/
/infra/local/pytest-tmp-locked-*.txt

# TypeScript incremental build state (regenerated by tsc)
*.tsbuildinfo
