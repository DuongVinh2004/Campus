+def flat_list_rows(text):
+    """Offsets of strict runs of >=8 consecutive numbered, non-pipe lines.
+
+    Validate the entire uninterrupted block: a repeated/skipped ordinal must
+    not leave a qualifying prefix. Context is at most two preceding lines;
+    source bodies retain their original line endings and exact boundaries.
+    """
+    lines = text.splitlines(keepends=True)
+    result, block, offset = {}, [], 0
+
+    def flush():
+        if len(block) >= 8 and all(b[2] == a[2] + 1 for a, b in zip(block, block[1:])):
+            context = "\n".join(line.strip() for line in lines[max(0, block[0][3] - 2):block[0][3]])
+            for start, end, _, _ in block:
+                result[start] = (end, context)
+        block.clear()
+
+    for i, line in enumerate(lines):
+        match = re.match(r"^(\d{1,3})\s+\S", line) if "|" not in line else None
+        if match:
+            block.append((offset, offset + len(line), int(match[1]), i))
+        else:
+            flush()
+        offset += len(line)
+    flush()
+    return result
+
+
