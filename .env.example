# Campus 24/7 — HUCE Demo (V1)
# Biến môi trường mẫu — Chỉ áp dụng cấu hình non-secret & local dev

APP_NAME="Campus 24/7 API"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
DATABASE_URL="postgresql+asyncpg://campus:campus_secret@localhost:5432/campus247"
REDIS_URL="redis://localhost:6379/0"
LOG_LEVEL="INFO"
DEMO_MODE=true

# --- Cài đặt khác đọc bởi services/api/src/campus247/bootstrap/settings.py (kiểm 2026-11-25) ---
# Bí mật KHÔNG đặt ở đây: khóa ký (IDENTITY_SECRET_KEY, CONFIRMATION_SIGNING_KEY) và khóa nhà cung cấp mô hình
# (DEEPSEEK_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY) lấy từ kho bí mật; giá trị mặc định không an toàn bị từ chối khi ENVIRONMENT là staging hoặc production.
# Lưu trữ phiên/hội thoại: ephemeral (mất khi tắt) | sqlite (cần *_SQLITE_PATH) | injected (do mã khởi tạo cấp)
# CONVERSATION_STORAGE_MODE="ephemeral"
# CONVERSATION_SQLITE_PATH=
# CONSENT_STORAGE_MODE="ephemeral"
# CONSENT_SQLITE_PATH=
# ACTOR_STATE_STORAGE_MODE="ephemeral"
# ACTOR_STATE_SQLITE_PATH=
# AGENT_RUN_STORAGE_MODE="disabled"
# AGENT_RUN_SQLITE_PATH=
# Mô hình ngôn ngữ (chỉ tên, URL; không phải khóa)
# LLM_PRIMARY_PROVIDER="deepseek"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LAB_MODEL="gemini-3.6-flash"
# LAB_MINI_MODEL="gemini-3.6-flash"
# Truy hồi: giữ mặc định trừ khi có hồ sơ truy hồi mới
# RETRIEVAL_PROFILE_VERSION=

# --- Biến CAMPUS247_* của runtime 8015 / cloud (mặc định an toàn; giá trị cloud xem infra/cloud/campus247.env.example và infra/profiles/*.toml) ---
# CAMPUS247_PROFILE=local                 # local | cloud (infra/profiles)
# CAMPUS247_RAG_ENGINE=v2                 # v1 | v2 (không đặt = v1, runtime trả lời bằng engine cũ)
# CAMPUS247_RAG_V2_INDEX=data/rag_v2_index/embedded2
# CAMPUS247_RAG_V2_HOT_RELOAD=1           # 0 = không tự nạp chỉ mục mới
# CAMPUS247_VECTOR_TIMEOUT_S=2.5          # chờ vector tối đa; quá hạn thì chỉ dùng BM25
# CAMPUS247_GATEWAY_URL=                  # gateway sidecar giữ khóa nhà cung cấp và sổ chi phí
# CAMPUS247_GATEWAY_TOKEN_FILE=           # đường dẫn tệp token, không phải giá trị token
# CAMPUS247_OIDC_CONFIG=                  # đường dẫn JSON cấu hình đăng nhập tài khoản trường (tuỳ chọn)
# CAMPUS247_SCANNER_PORT=                 # clamd; CAMPUS247_SCANNER_SOCKET cho Linux
# CAMPUS247_SCANNER_RETRY_SECONDS=75
# CAMPUS247_SCANNER_MAX_DATABASE_AGE_HOURS=72
# CAMPUS247_BACKUP_DIR=
# CAMPUS247_ALERT_*                       # kênh cảnh báo SMTP/Telegram: xem infra/cloud/alerts.env.example
